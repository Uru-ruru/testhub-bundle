{% extends '@WebProfiler/Profiler/layout.html.twig' %}

{% macro icon() %}
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-sandbox">
        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
        <path d="M19.953 8.017l1.047 6.983v2a3 3 0 0 1 -3 3h-12a3 3 0 0 1 -3 -3v-2l1.245 -8.297a2 2 0 0 1 1.977 -1.703h3.778" />
        <path d="M3 15h18" />
        <path d="M13 3l5.5 1.5" />
        <path d="M15.75 3.75l-2 7" />
        <path d="M7 10.5c1.667 -.667 3.333 -.667 5 0c1.667 .667 3.333 .667 5 0" />
    </svg>
{% endmacro %}

{% block toolbar %}
    {% set icon %}
        {{ _self.icon() }}
        <span class="sf-toolbar-value">Sandbox {{ collector.sandbox ? 'on' : 'off' }}</span>
        {% if collector.requestCount %}
            <span class="sf-toolbar-info-piece-additional-detail">
                <span class="sf-toolbar-label">({{ collector.sandboxedCount }}/{{ collector.requestCount }})</span>
            </span>
        {% endif %}
    {% endset %}

    {% set text %}
        <div class="sf-toolbar-info-piece">
            <b>Sandbox status</b>
            <span class="sf-toolbar-status sf-toolbar-status-{{ collector.sandbox ? 'green' : 'red' }}">{{ collector.sandbox ? 'On' : 'Off' }}</span>
        </div>
        <div class="sf-toolbar-info-piece">
            <b>Source</b>
            <span>{{ collector.override is null ? 'config default' : 'profiler switch' }}</span>
        </div>
        <div class="sf-toolbar-info-piece">
            <b>Sandbox URL</b>
            <span class="sf-toolbar-status sf-toolbar-status-{{ collector.configured ? 'green' : 'red' }}">{{ collector.configured ? 'Configured' : 'Missing' }}</span>
        </div>
        <div class="sf-toolbar-info-piece">
            <b>HTTP requests</b>
            <span>{{ collector.sandboxedCount }} sandboxed / {{ collector.requestCount }} total</span>
        </div>
        {% if collector.configured %}
            <div class="sf-toolbar-info-piece">
                <b>Use sandbox</b>
                <span>
                    <a href="#" onclick="document.cookie='{{ constant('TestHub\\Bundle\\Service\\SandBoxService::COOKIE_NAME') }}={{ collector.sandbox ? '0' : '1' }}; path=/; SameSite=Lax'; location.reload(); return false;">{{ collector.sandbox ? 'Turn off' : 'Turn on' }}</a>
                </span>
            </div>
        {% endif %}
    {% endset %}

    {{ include('@WebProfiler/Profiler/toolbar_item.html.twig', {
        link: true,
        status: collector.sandbox ? (collector.errorCount ? 'red' : 'green') : '',
    }) }}
{% endblock %}

{% block menu %}
    <span class="label{{ collector.requestCount ? '' : ' disabled' }}">
        <span class="icon">{{ _self.icon() }}</span>
        <strong>Test Hub</strong>
        {% if collector.sandboxedCount %}
            <span class="count">{{ collector.sandboxedCount }}</span>
        {% endif %}
    </span>
{% endblock %}

{% block panel %}
    {% set cookie_name = constant('TestHub\\Bundle\\Service\\SandBoxService::COOKIE_NAME') %}

    <h2>Test Hub sandbox</h2>

    <div class="metrics">
        <div class="metric">
            <span class="value">{{ source('@WebProfiler/Icon/' ~ (collector.sandbox ? 'yes' : 'no') ~ '.svg') }}</span>
            <span class="label">Sandbox</span>
        </div>

        <div class="metric-group">
            <div class="metric">
                <span class="value">{{ collector.requestCount }}</span>
                <span class="label">HTTP requests</span>
            </div>

            <div class="metric">
                <span class="value">{{ collector.sandboxedCount }}</span>
                <span class="label">Sent to sandbox</span>
            </div>

            <div class="metric">
                <span class="value">{{ collector.errorCount }}</span>
                <span class="label">Errors</span>
            </div>
        </div>
    </div>

    {% if not collector.configured %}
        <div class="empty">
            <p>The sandbox URL is not configured. Set <code>SANDBOX_URL</code> or <code>test_hub.sandbox_url</code>; until then every request goes to its real destination.</p>
        </div>
    {% endif %}

    <h2>Controls</h2>
    <p class="help">These settings are stored as cookies in this browser and apply to the next requests you make.</p>
    <form method="get" id="sandbox-event-controls" onsubmit="return false;">
        <table>
            <tr>
                <th><label for="sandbox-use">Use sandbox</label></th>
                <td>
                    <select id="sandbox-use" name="{{ cookie_name }}" class="sandbox-event-control"{{ collector.configured ? '' : ' disabled' }}>
                        <option value="">Config default ({{ collector.default ? 'on' : 'off' }})</option>
                        <option value="1"{{ collector.override is same as(true) ? ' selected' : '' }}>On</option>
                        <option value="0"{{ collector.override is same as(false) ? ' selected' : '' }}>Off</option>
                    </select>
                </td>
            </tr>
            <tr>
                <th><label for="sandbox-deposit-event">Deposit event</label></th>
                <td>
                    <select id="sandbox-deposit-event" name="deposit_event" class="sandbox-event-control">
                        <option value="">-</option>
                        <option value="success"{{ collector.depositEvent == 'success' ? ' selected' : '' }}>success</option>
                        <option value="fail"{{ collector.depositEvent == 'fail' ? ' selected' : '' }}>fail</option>
                    </select>
                </td>
            </tr>
            <tr>
                <th><label for="sandbox-withdrawal-event">Withdrawal event</label></th>
                <td>
                    <select id="sandbox-withdrawal-event" name="withdrawal_event" class="sandbox-event-control">
                        <option value="">-</option>
                        <option value="success"{{ collector.withdrawalEvent == 'success' ? ' selected' : '' }}>success</option>
                        <option value="fail"{{ collector.withdrawalEvent == 'fail' ? ' selected' : '' }}>fail</option>
                    </select>
                </td>
            </tr>
        </table>
        <p id="sandbox-controls-saved" class="help" hidden>Saved. Reload your application page to apply.</p>
    </form>

    <script>
        (function () {
            var form = document.getElementById('sandbox-event-controls');

            if (!form) {
                return;
            }

            var readCookie = function (name) {
                var match = document.cookie.match(new RegExp('(?:^|; )' + name + '=([^;]*)'));

                return match ? decodeURIComponent(match[1]) : '';
            };

            Array.prototype.forEach.call(form.querySelectorAll('.sandbox-event-control'), function (control) {
                // The profile shows a past request; the cookie holds what the next request will use.
                control.value = readCookie(control.name);

                control.addEventListener('change', function () {
                    document.cookie = control.value === ''
                        ? control.name + '=; path=/; max-age=0; SameSite=Lax'
                        : control.name + '=' + encodeURIComponent(control.value) + '; path=/; SameSite=Lax';
                    document.getElementById('sandbox-controls-saved').hidden = false;
                });
            });
        })();
    </script>

    <h2>HTTP requests</h2>
    {% if collector.requests is empty %}
        <div class="empty">
            <p>No HTTP requests were made through <code>http_client</code> during this request.</p>
        </div>
    {% else %}
        {% for request in collector.requests %}
            <table class="{{ request.error or request.status_code >= 400 ? 'status-error' : '' }}">
                <thead>
                    <tr>
                        <th class="nowrap">
                            {% if request.sandboxed %}
                                <span class="label status-success">sandbox</span>
                            {% else %}
                                <span class="label">real</span>
                            {% endif %}
                            {{ request.method }}
                        </th>
                        <th class="full-width">{{ request.url }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% if request.sandboxed %}
                        <tr>
                            <th>Sent to</th>
                            <td>{{ request.target_url }}</td>
                        </tr>
                        <tr>
                            <th>Type / event</th>
                            <td>{{ request.type ?? '(wrap)' }} / {{ request.event }}</td>
                        </tr>
                    {% endif %}
                    <tr>
                        <th>Status</th>
                        <td>
                            {% if request.error %}
                                <span class="label status-error">{{ request.error }}</span>
                            {% elseif request.status_code %}
                                <span class="label {{ request.status_code >= 400 ? 'status-error' : 'status-success' }}">{{ request.status_code }}</span>
                            {% else %}
                                <span class="label">no response</span>
                            {% endif %}
                            {% if request.duration is not null %}
                                <span class="text-muted">{{ '%.0f'|format(request.duration) }} ms</span>
                            {% endif %}
                        </td>
                    </tr>
                    <tr>
                        <th>Request options</th>
                        <td>{{ profiler_dump(request.options, maxDepth=2) }}</td>
                    </tr>
                    <tr>
                        <th>Response headers</th>
                        <td>{{ profiler_dump(request.response_headers, maxDepth=1) }}</td>
                    </tr>
                    {% if request.response_body is not null %}
                        <tr>
                            <th>Response body</th>
                            <td>
                                {% if request.response_body is iterable %}
                                    {{ profiler_dump(request.response_body, maxDepth=3) }}
                                {% else %}
                                    <pre class="sf-dump">{{ request.response_body }}</pre>
                                {% endif %}
                            </td>
                        </tr>
                    {% endif %}
                </tbody>
            </table>
        {% endfor %}
    {% endif %}

    <h2>Configuration</h2>
    <table>
        <tr>
            <th>Default state</th>
            <td>{{ collector.default ? 'On' : 'Off' }}</td>
        </tr>
        <tr>
            <th>This request</th>
            <td>{{ collector.sandbox ? 'On' : 'Off' }} ({{ collector.override is null ? 'config default' : 'profiler switch' }})</td>
        </tr>
        <tr>
            <th>Url</th>
            <td>{{ collector.url }}</td>
        </tr>
        <tr>
            <th>Wrap url</th>
            <td>{{ collector.urlWrap }}</td>
        </tr>
        <tr>
            <th>Api key</th>
            <td>{{ collector.apikey }}</td>
        </tr>
        <tr>
            <th>Tests</th>
            <td>{{ collector.tests ? 'On' : 'Off' }}</td>
        </tr>
        <tr>
            <th>Collected at</th>
            <td>{{ collector.time|round|date('Y-m-d H:i:s') }}</td>
        </tr>
    </table>
{% endblock %}
