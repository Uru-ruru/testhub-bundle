{
    "name": "uru/testhub-bundle",
    "description": "TestHub Bundle for Symfony: routes HttpClient traffic to a TestHub sandbox from the web profiler (dev only)",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Alexander Petrov"
        }
    ],
    "require": {
        "php": ">=8.4",
        "symfony/config": "^7.3 || ^8.0",
        "symfony/dependency-injection": "^7.3 || ^8.0",
        "symfony/framework-bundle": "^7.3 || ^8.0",
        "symfony/http-client": "^7.3 || ^8.0",
        "symfony/http-client-contracts": "^3.5",
        "symfony/http-foundation": "^7.3 || ^8.0",
        "symfony/http-kernel": "^7.3 || ^8.0",
        "symfony/routing": "^7.3 || ^8.0",
        "symfony/service-contracts": "^3.5",
        "symfony/var-dumper": "^7.3 || ^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpunit/phpunit": "^10.0",
        "symfony/browser-kit": "^7.3 || ^8.0",
        "symfony/twig-bundle": "^7.3 || ^8.0",
        "symfony/web-profiler-bundle": "^7.3 || ^8.0"
    },
    "suggest": {
        "symfony/web-profiler-bundle": "Required to see the Test Hub panel and the \"Use sandbox\" switch"
    },
    "autoload": {
        "psr-4": {
            "TestHub\\Bundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TestHub\\Bundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "lint": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "fix": "vendor/bin/php-cs-fixer fix"
    },
    "extra": {
        "branch-alias": {
            "dev-develop": "1.0.x-dev"
        }
    }
}
